# Code Forge 环境变量示例。用法：cp deploy/.env.example .env 后按需修改。
# 凭证类（SECRET_KEY / *_API_KEY）生产必须注入强随机值，切勿提交真实 .env。

# 运行环境：dev / prod / test
APP_ENV=dev
DEBUG=false

# 服务监听
HOST=0.0.0.0
PORT=8000

# PostgreSQL（compose 内用服务名 postgres）
PG_DSN=postgresql+asyncpg://codeforge:codeforge@postgres:5432/codeforge

# Redis（compose 内用服务名 redis）
REDIS_URL=redis://redis:6379/0

# 凭证加密主密钥（D32 / NF4.2.4），生产必须改为强随机串
SECRET_KEY=dev-insecure-secret-key-change-me

# 飞书开放平台（T3.3 / T4.1）
FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# Anthropic（T5.1；国内可切 GLM，见 D3）
ANTHROPIC_API_KEY=

# 文件系统根（工作空间 / 全局广场，design §2.3）
DATA_DIR=./data

# 初始管理员（dev 未配密码时自动用 admin/admin；生产必须改为强随机）
INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD=       # dev 留空即 admin/admin；生产必填强随机
